  "info": {
    "_postman_id": "26ceeab1-c7eb-4ec3-9f3f-9a40912b7a17",
    "name": "Orama Cloud Answer Indexes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Specification of the Orama Cloud REST API. Orama Cloud is the hosted, managed platform built on the open-source Orama search engine. It exposes three host families: a webhook management API for index administration and document ingestion (api.askorama.ai), a per-index search host (cloud.orama.run), and an answer/RAG host (answer.api.orama.com). The open-source @orama/orama library itself is a JavaScript library invoked via function calls and is not modeled here as an HTTP API.\n\nContact Support:\n Name: Orama Support",
      "type": "text/plain"
    }
  }
